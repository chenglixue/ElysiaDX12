# 基础风格基于 LLVM
BasedOnStyle: LLVM

# 核心：花括号换行策略（Allman 风格）
BreakBeforeBraces: Allman

# 语言设置
Language: Cpp

# 缩进设置
IndentWidth: 4
TabWidth: 4
UseTab: Never

# 指针对齐：左对齐 (int* ptr)
PointerAlignment: Left

# 连续行对齐设置
AlignConsecutiveMacros: AcrossEmptyLinesAndComments
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None

# 访问修饰符（public/private）偏移
AccessModifierOffset: -4 

# 允许短代码单行化设置
AllowShortFunctionsOnASingleLine: Empty
AllowShortBlocksOnASingleLine: false
AllowShortLambdasOnASingleLine: All
AllowShortLoopsOnASingleLine: false

# 括号前后空格设置
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesInContainerLiterals: false

# 强制每行最大空行数
MaxEmptyLinesToKeep: 1

# 头文件排序：DX12项目建议关闭
SortIncludes: Never

# 每行最大长度
ColumnLimit: 120  # 增加到120，为长参数列表留出空间

# 针对构造函数初始化列表的缩进
ConstructorInitializerIndentWidth: 4
AlignAfterOpenBracket: Align

# 核心设置：None 表示命名空间内部的代码不缩进
NamespaceIndentation: All

# extern "C" 内部保持缩进
IndentExternBlock: AfterExternBlock

# ========== 以下是新增的"一个参数一行"配置 ==========

# 函数调用参数：不打包，每个参数单独一行
BinPackArguments: false

# 函数声明参数：不打包，每个参数单独一行  
BinPackParameters: false

# 模板参数：不打包，每个参数单独一行
BinPackTemplateParameters: false

# 构造函数初始化列表：每个初始化单独一行
ConstructorInitializerAllOnOneLineOrOnePerLine: true

# 允许所有声明参数在下一行：关闭（强制每个参数单独一行）
AllowAllParametersOfDeclarationOnNextLine: false

# 允许所有函数调用参数在下一行：关闭（强制每个参数单独一行）
AllowAllArgumentsOnNextLine: false

# 换行惩罚设置（降低单行参数列表的优先级）
PenaltyExcessCharacter: 100  # 增加行长的惩罚
PenaltyReturnTypeOnItsOwnLine: 200
PenaltyBreakBeforeFirstCallParameter: 300

# 模板声明总是换行
AlwaysBreakTemplateDeclarations: Yes

# 保留已有的花括号换行设置
BraceWrapping:
  AfterClass: true
  AfterControlStatement: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: true
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true